# Local SQLite (default, simplest for dev + university demo)
DATABASE_URL="file:./dev.db"
# For production on Vercel, use a managed Postgres URL instead, e.g.:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Directory where generated PDF reports are stored (served via a Next.js route).
REPORTS_DIR="./reports"

# Optional: URL of the scanner-worker service that runs OWASP ZAP baseline.
# If unset, the ZAP baseline check is marked as "skipped" (Not Tested) and the
# scan proceeds with custom checks only (Partial Scan).
SCANNER_WORKER_URL=""
# Shared secret used to sign/verify requests between the web app and the worker (HMAC).
SCANNER_WORKER_SECRET=""

# Timeouts (ms) applied to all outbound scan requests to the target site.
SCAN_HTTP_TIMEOUT_MS=10000

# DANGEROUS local/demo-only escape hatch: when "true", the SSRF policy stops
# blocking private/loopback network targets (e.g. a local Docker Compose
# service or OWASP Juice Shop on 172.x/localhost), so the scanner can be
# demonstrated fully offline. Cloud metadata addresses are still always
# blocked. NEVER set this to "true" on any deployment reachable from the
# public internet. See docs/decisions.md.
SCAN_ALLOW_PRIVATE_NETWORKS=false
